# Copy to .env (or export) and fill in what you need. Nothing here is required for a
# fully local run against your own vLLM server.

# --- Local vLLM server (defaults shown; see docs/vllm.md) ---
# YOAO_VLLM_URL=http://localhost:8000/v1
# YOAO_BASE_MODEL=Qwen/Qwen3-14B                      # --served-model-name of the base model
# YOAO_SFT_MODEL=redblackbench-qwen3-14b-sft-v2       # --lora-modules name of the cooperative seed

# --- OpenRouter: cross-model teammates (LLaMA, Mistral), the Kimi-K2 teacher, GPT-4o-mini evaluator ---
OPENROUTER_API_KEY=

# --- Optional providers ---
# ANTHROPIC_API_KEY=        # only for the Anthropic provider (not used by the paper's experiments)
# OPENAI_API_KEY=           # only for the OpenAI provider (not used by the paper's experiments)
# AIHUBMIX_API_KEY=         # optional second OpenRouter-compatible endpoint for load balancing
